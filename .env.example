# Provider keys — leave blank for any provider you don't use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# Router
ROUTER_HOST=0.0.0.0
ROUTER_PORT=4000
ROUTER_ROUTES_FILE=./config/routes.yaml
ROUTER_DB_PATH=./router.db
ROUTER_ADMIN_KEY=

# Comma-separated Python modules imported at startup that register custom content hooks
# with router.pii.register_hook(name, fn); reference them by name under `privacy:` in routes.yaml.
ROUTER_HOOK_MODULES=

# Policy-as-code. Empty: ./config/policies.yaml if it exists. A path that is set but missing
# or invalid stops startup (fail closed).
ROUTER_POLICIES_FILE=
# Optional OPA sidecar, e.g. http://127.0.0.1:8181 (run: opa run --server policies/).
# When set, OPA must also allow every request; if it can't be reached, requests get 503.
OPA_URL=
# Largest request body accepted (413 above it); 0 disables the check.
ROUTER_MAX_BODY_BYTES=1048576

# MCP tool gateway config. Empty: ./config/mcp.yaml if it exists (start from config/mcp.example.yaml).
ROUTER_MCP_FILE=
# Upstream MCP server credentials are read from the variables named in headers_from_env, e.g.:
# MCP_TICKETS_AUTH=Bearer <token for the tickets MCP server>

# Optional pepper for hashing app keys at rest (keep it out of the database host; changing it invalidates existing keys)
ROUTER_KEY_PEPPER=
